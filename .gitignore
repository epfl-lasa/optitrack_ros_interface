# Ignore files generated by the build process
ros2_ws/src/optitrack_ros2_interface/build/
ros2_ws/src/optitrack_ros2_interface/install/
ros2_ws/src/optitrack_ros2_interface/log/

ros2_ws/build/
ros2_ws/log/
dist/
# Ignore files generated by the installation process
ros2_ws/install/
*.exe
*.dll
# Ignore system and IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
# Ignore log files and temporary files
*.log
*.tmp
*.swp
# Ignore package manager directories
node_modules/
vendor/
# Ignore compiled binaries and libraries
*.o
*.so
*.a
# Ignore environment-specific files
.env
.env.local
.env.*.local
# Ignore sensitive or personal files
secrets.txt
credentials.json
# Ignore backup files
*.bak
*.backup
# Ignore recording files
/data/

# Ignore ROS 1 workspace outputs
/ros_ws/build/
/ros_ws/devel/
/ros_ws/install/
/ros_ws/log/

# Ignore Python-generated files and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
