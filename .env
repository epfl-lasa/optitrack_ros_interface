# Rig configuration, tracked in git. ROS middleware settings (ROS_DOMAIN_ID,
# RMW_IMPLEMENTATION, ROS_MASTER_URI) live on the services in docker-compose.yml.

# PC running Motive.
OPTITRACK_SERVER=128.178.145.172
OPTITRACK_PORT=3883

# Rigid bodies to republish. Comma separated, no spaces, no quotes.
# Letters, digits and underscores only: the ROS 1 path parses this as inline
# YAML, so other names are silently coerced and the whole list fails to load.
OPTITRACK_OBJECTS=target_box,HO_torso,HO_arm_right_sh,HO_arm_right_wr,HO_arm_left_sh,HO_arm_left_wr,AO_wr,AO_sh

# Rigid body marking the robot base. Poses are expressed relative to it and
# stamped with its name as header.frame_id.
OPTITRACK_BASE_OBJECT=neura_base
