<launch>
    <!-- Tracked config, including rig values (server, objects, base) and
         driver settings, lives in config/optitrack_cfg.yaml. Edit it directly
         for a given site; OPTITRACK_CONFIG points elsewhere if ever needed. -->
    <arg name="config_file" default="$(optenv OPTITRACK_CONFIG /opt/optitrack/config/optitrack_cfg.yaml)"/>

    <rosparam file="$(arg config_file)" command="load"/>

    <!-- vrpn Optitrack -->
    <node pkg="vrpn_client_ros" type="vrpn_client_node" name="vrpn_client_node" output="screen">
        <rosparam subst_value="true">
        broadcast_tf: true
        update_frequency: 1000.0          # keep above Motive's rate, else samples arrive in bursts
        refresh_tracker_frequency: 1.0    # rescan for new rigid bodies, Hz
        </rosparam>
    </node>

    <!-- Transform to robot base. list_object/name_base come from the config
         file, loaded above into this node's own private namespace. -->
    <node pkg="optitrack_ros_interface" type="optitrack_transform_publisher"
          name="optitrack_ros_interface" output="screen"/>

</launch>
