<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>optitrack_ros_interface</name>
  <version>1.0.0</version>
  <description>
    Republishes OptiTrack/Motive rigid-body poses received over VRPN, expressed
    in a robot base frame instead of the mocap world frame.
  </description>

  <maintainer email="tristan.bonato@epfl.ch">Tristan Bonato</maintainer>
  <maintainer email="bruno.agostinhodacosta@epfl.ch">Bruno Agostinho Da Costa</maintainer>
  <!-- Was BSD, which contradicted the repository LICENSE file. -->
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/epfl-lasa/optitrack_ros_interface</url>
  <url type="bugtracker">https://github.com/epfl-lasa/optitrack_ros_interface/issues</url>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>geometry_msgs</depend>
  <depend>eigen</depend>

  <!-- Started by the launch file; previously installed by apt in the Dockerfile
       without ever being declared here. -->
  <exec_depend>vrpn_client_ros</exec_depend>

  <export/>
</package>
